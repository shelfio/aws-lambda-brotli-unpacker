{
  "name": "@shelf/aws-lambda-brotli-unpacker",
  "version": "2.1.0",
  "description": "Unpacks large Lambda binaries to /tmp",
  "keywords": [
    "lambda",
    "brotli"
  ],
  "repository": "shelfio/aws-lambda-brotli-unpacker",
  "license": "MIT",
  "author": {
    "name": "Vlad Holubiev",
    "email": "vlad@shelf.io",
    "url": "shelf.io"
  },
  "sideEffects": false,
  "type": "module",
  "exports": "./lib/index.js",
  "module": "./lib/index.js",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "rm -rf lib/ && tsc",
    "coverage": "pnpm test --coverage",
    "lint": "oxfmt && eslint . --quiet --fix",
    "lint:ci": "oxfmt --check && eslint . --quiet",
    "prepack": "pnpm build",
    "test": "bin/test",
    "test:internal": "rm -rf .test && mkdir .test && jest",
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch"
  },
  "lint-staged": {
    "*.{html,md,yml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,ts,json}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "tar-fs": "3.1.1"
  },
  "devDependencies": {
    "@shelf/eslint-config": "7.2.0",
    "@shelf/prettier-config": "1.1.1",
    "@shelf/tsconfig": "0.2.0",
    "@swc/core": "1.15.11",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "20",
    "@types/tar-fs": "2.0.4",
    "eslint": "10.8.0",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "jest-junit": "16.0.0",
    "lint-staged": "16.2.7",
    "oxfmt": "0.64.0",
    "ts-jest-resolver": "2.0.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.18.0"
}
